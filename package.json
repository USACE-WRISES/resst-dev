{
  "name": "resst",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Reservoir Sustainable Sediment Tool — static web application and authoritative dataset",
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "validate": "node scripts/validate.mjs",
    "build:data": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "gen:filters": "node scripts/gen-filter-config.mjs"
  },
  "dependencies": {
    "@mapbox/shp-write": "^0.4.3",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.10",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
